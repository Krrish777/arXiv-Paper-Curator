# Example environment configuration for arXiv RAG system
# Copy this file to .env and fill in your actual values

# Application Configuration
APP_NAME=arXiv RAG API
APP_VERSION=0.1.0
APP_DESCRIPTION=Production-grade Retrieval-Augmented Generation system
DEBUG=false
ENVIRONMENT=development

# Container Configuration
API_CONTAINER_NAME=rag-api
POSTGRES_CONTAINER_NAME=rag-postgres
OPENSEARCH_CONTAINER_NAME=rag-opensearch
DASHBOARDS_CONTAINER_NAME=rag-dashboards
AIRFLOW_CONTAINER_NAME=rag-airflow

# Port Configuration - Change these if you have conflicts
API_PORT=8000
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
DASHBOARDS_PORT=5601
AIRFLOW_PORT=8080

# Docker Image Tags - Update these for different versions
POSTGRES_IMAGE=postgres:16-alpine
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.0
DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.19.0
AIRFLOW_IMAGE=apache/airflow:3.0.3

# Database Configuration - CHANGE THESE FOR PRODUCTION!
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST_AUTH_METHOD=password
PGDATA=/var/lib/postgresql/data/pgdata

# Database URLs - Will be auto-generated based on above values
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0

# Service URLs - Internal container networking
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_HOSTS=http://opensearch:9200

# OpenSearch Configuration
OPENSEARCH_DISCOVERY_TYPE=single-node
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
DISABLE_SECURITY_PLUGIN=true
DISABLE_SECURITY_DASHBOARDS_PLUGIN=true
BOOTSTRAP_MEMORY_LOCK=true

# Airflow Configuration
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_HOME=/opt/airflow/home
AIRFLOW_PYTHONPATH=/opt/airflow/src
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_password_here

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_START_PERIOD=60s

# PostgreSQL Health Check
PG_HEALTH_CHECK_INTERVAL=5s
PG_HEALTH_CHECK_TIMEOUT=5s
PG_HEALTH_CHECK_RETRIES=10
PG_HEALTH_CHECK_START_PERIOD=30s

# API Health Check
API_HEALTH_CHECK_INTERVAL=30s
API_HEALTH_CHECK_TIMEOUT=10s
API_HEALTH_CHECK_RETRIES=3
API_HEALTH_CHECK_START_PERIOD=40s

# Airflow Health Check
AIRFLOW_HEALTH_CHECK_INTERVAL=30s
AIRFLOW_HEALTH_CHECK_TIMEOUT=10s
AIRFLOW_HEALTH_CHECK_RETRIES=5
AIRFLOW_HEALTH_CHECK_START_PERIOD=120s

# Network Configuration
NETWORK_NAME=rag-network

# HuggingFace Configuration - GET YOUR TOKEN FROM https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL=thenlper/gte-base
EMBEDDING_DEVICE=gpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=512

# OpenAI Configuration via HuggingFace
OPENAI_MODEL=openai/gpt-oss-120b:fireworks-ai
OPENAI_API_BASE=https://router.huggingface.co/v1
OPENAI_API_KEY=your_huggingface_token_here

# Memory Limits (for ulimits)
MEMLOCK_SOFT=-1
MEMLOCK_HARD=-1

# ===========================================
# REQUIRED SETUP STEPS:
# 1. Copy this file to .env
# 2. Replace all "your_*_here" values with actual credentials
# 3. Get HuggingFace token from https://huggingface.co/settings/tokens
# 4. Change default passwords for production use
# 5. Adjust ports if you have conflicts
# ===========================================
